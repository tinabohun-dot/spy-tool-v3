# Turso (libSQL) — постоянная база на бесплатном хостинге, где нет своего
# диска (Render и т.п.). Если не заданы — используется обычный файл
# server/data/spy.db (для локальной разработки).
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Токен доступа Meta for Developers с правами на Ad Library API
META_ACCESS_TOKEN=

PORT=3000

# Расписание ежедневного автосбора снепшотов (формат cron). По умолчанию — 03:00 каждый день.
CRON_SCHEDULE=0 3 * * *

# Рекламные кабинеты (Marketing API) для вкладки "Аналитика" — свой перформанс,
# а не публичные объявления конкурентов. Формат: Название:act_id, через запятую.
META_MARKETING_ACCOUNTS=

# Airtable — креативный продакшн (вкладки Продакшн/CP/Утилизация)
AIRTABLE_TOKEN=
AIRTABLE_BASE_ID=
AIRTABLE_TABLE_ID=

# Slack Incoming Webhook — ежедневное уведомление (11:00 по Варшаве) о
# креативах из Аналитики, поднявшихся до Promising+ за прошедшие сутки.
SLACK_WEBHOOK_URL=

# Google OAuth (личный аккаунт) — поиск видео в Drive по имени креатива для
# Slack-уведомлений. GOOGLE_REFRESH_TOKEN появится после /oauth2/start.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:3000/oauth2/callback
GOOGLE_REFRESH_TOKEN=
